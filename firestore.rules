rules_version = '2';
// Demandes de travaux publiées par des comptes Particulier vérifiés (onglets Privé – sociétés et Particuliers)
// ou Entreprise vérifiés (onglet Privé – sociétés seulement).
// demandes/{id} : la demande, lisible par tous UNIQUEMENT une fois validée ; jamais de coordonnées dedans (uid = compte auteur).
// Son auteur la voit aussi en attente (« Mes demandes »).
// demandes/{id}/prive/contact : nom, téléphone, e-mail, lisibles par l'administrateur seulement.
// demandes/{id}/photos/{1,2,3} : photos de la demande (JPEG en octets), lisibles comme la demande.
// demandes/{id}/interets/{uid} : messages « Je suis intéressé » des comptes Entreprise vérifiés (un par entreprise, 5 au plus),
// lisibles par l'administrateur seulement (l'entreprise peut seulement voir que le sien existe).
// users/{uid} : profil du compte (particulier ou entreprise de travaux), lisible par son titulaire et l'admin seulement.
// fiches/{uid} : fiche publique facultative d'une entreprise, lisible par tous après validation par l'admin.
// types/{uid} : type du compte, figé pour toujours (même si le profil est supprimé puis recréé).
// config/admins : { uids: [...] }, créé à la main dans la console Firebase (aucune écriture possible depuis le site).
service cloud.firestore {
  match /databases/{database}/documents {

    function estAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/config/admins)
        && request.auth.uid in get(/databases/$(database)/documents/config/admins).data.uids;
    }

    function texte(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function connecte(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // compte connecté, e-mail vérifié, et profil du bon type (particulier pour publier, entreprise pour répondre)
    function compteVerifie(type) {
      return request.auth != null && request.auth.token.email_verified == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.type == type;
    }

    function metiersConnus() {
      return ['gros-oeuvre', 'second-oeuvre', 'electricite', 'plomberie-cvc', 'voirie-vrd', 'espaces-verts',
              'nettoyage', 'informatique', 'etudes', 'restauration', 'services', 'fournitures'];
    }

    function telephoneValide(c) {
      return !('telephone' in c) || (c.telephone is string && c.telephone.matches('[+0-9 .()-]{6,20}'));
    }

    // assurance décennale déclarée par l'entreprise (non vérifiée : le demandeur demande l'attestation) ; fin = date « AAAA-MM-JJ »
    function decennaleValide(d) {
      return d is map && d.keys().hasOnly(['assureur', 'contrat', 'fin']) && texte(d.assureur, 2, 80)
        && (!('contrat' in d) || texte(d.contrat, 1, 40))
        && d.fin is string && d.fin.matches('20[0-9]{2}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])');
    }

    // shortcut: la clé de contrôle du SIRET (Luhn) n'est vérifiée que dans le navigateur ; ici, 14 chiffres. À revoir si de faux SIRET passent.
    function profilValide(p) {
      return telephoneValide(p) && texte(p.nom, 2, 80) && (
        (p.type == 'particulier' && p.keys().hasOnly(['type', 'nom', 'commune', 'telephone', 'cree']) && texte(p.commune, 2, 60))
        || (p.type == 'entreprise' && p.keys().hasOnly(['type', 'nom', 'siret', 'metiers', 'zone', 'telephone', 'cree', 'alertes', 'decennale'])
          && (!('alertes' in p) || p.alertes is bool) // alertes e-mail par métier (outils/envoyer_emails.py), cochées dans compte.html
          && (!('decennale' in p) || decennaleValide(p.decennale))
          && p.siret is string && p.siret.matches('[0-9]{14}')
          && p.metiers is list && p.metiers.size() >= 1 && p.metiers.size() <= 12 && p.metiers.toSet().size() == p.metiers.size()
          && p.metiers.hasOnly(metiersConnus())
          && p.zone is list && p.zone.size() >= 1 && p.zone.size() <= 2 && p.zone.toSet().size() == p.zone.size()
          && p.zone.hasOnly(['2A', '2B'])));
    }

    function demandeValide(d) {
      return d.keys().hasOnly(['type', 'metier', 'titre', 'description', 'commune', 'departement', 'budget', 'delai', 'statut', 'cree', 'uid', 'photos'])
        && (!('photos' in d) || (d.photos is int && d.photos >= 1 && d.photos <= 3)) // nombre de photos (demandes/{id}/photos/1 à 3)
        && d.keys().hasAll(['type', 'metier', 'titre', 'description', 'commune', 'departement', 'delai', 'statut', 'cree', 'uid'])
        && d.uid == request.auth.uid
        && d.type in ['prive', 'particulier']
        && d.metier in metiersConnus()
        && texte(d.titre, 5, 120)
        && texte(d.description, 20, 1500)
        && texte(d.commune, 2, 60)
        && d.departement in ['2A', '2B']
        && (!('budget' in d) || (d.budget is int && d.budget >= 0 && d.budget <= 10000000))
        && d.delai is timestamp && d.delai > request.time && d.delai < request.time + duration.value(120, 'd')
        && d.statut == 'en_attente'
        && d.cree == request.time;
    }

    // nom + téléphone et/ou e-mail + consentement, communs au demandeur et à l'artisan intéressé
    function coordonneesValides(c) {
      return texte(c.nom, 2, 80)
        && ('telephone' in c || 'email' in c)
        && telephoneValide(c)
        && (!('email' in c) || (texte(c.email, 6, 120) && c.email.matches('[^@ ]+@[^@ ]+[.][^@ ]+')))
        && c.consentement == true
        && c.cree == request.time;
    }

    function contactValide(c) {
      return c.keys().hasOnly(['nom', 'telephone', 'email', 'consentement', 'cree']) && coordonneesValides(c);
    }

    function interetValide(i) {
      return i.keys().hasOnly(['nom', 'telephone', 'email', 'message', 'consentement', 'cree', 'uid'])
        && i.uid == request.auth.uid
        && coordonneesValides(i)
        && texte(i.message, 10, 1000);
    }

    // « Je cherche un partenaire » : n° d'avis BOAMP (26-93354), son titre et sa date limite (pour l'admin, qui supprime 3 mois après),
    // les coordonnées et le message
    function partenaireValide(p) {
      return p.keys().hasOnly(['avis', 'objet', 'limite', 'nom', 'telephone', 'email', 'message', 'consentement', 'cree', 'uid'])
        && p.uid == request.auth.uid
        && p.avis is string && p.avis.matches('[0-9]{2}-[0-9]{1,7}')
        && texte(p.objet, 1, 300)
        && p.limite is timestamp
        && coordonneesValides(p)
        && texte(p.message, 10, 1000);
    }

    // au plus 5 entreprises par demande (nbInterets, tenu à jour avec chaque message « Je suis intéressé »)
    function nbInterets(d) {
      return d.get('nbInterets', 0);
    }

    // ouverte aux réponses : validée, pas close, pas marquée pourvue par son auteur, moins de 5 entreprises
    function ouverte(d) {
      return d.statut == 'validee' && d.delai > request.time && d.get('pourvue', false) == false && nbInterets(d) < 5;
    }

    match /demandes/{id} {
      allow get, list: if resource.data.statut == 'validee' || estAdmin()
        || (request.auth != null && resource.data.uid == request.auth.uid);
      // la demande et ses coordonnées arrivent ensemble (une seule écriture groupée), toujours « en attente »
      allow create: if (compteVerifie('particulier') || (compteVerifie('entreprise') && request.resource.data.type == 'prive'))
        && demandeValide(request.resource.data)
        && existsAfter(/databases/$(database)/documents/demandes/$(id)/prive/contact);
      // admin : statut, reponses (nombre de réponses transmises au demandeur, étape « Réponses reçues » de Mes demandes),
      // nbInterets (recalculé quand il supprime un message)
      allow update: if (estAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'reponses', 'nbInterets'])
          && request.resource.data.statut in ['en_attente', 'validee']
          && (!('reponses' in request.resource.data)
            || (request.resource.data.reponses is int && request.resource.data.reponses >= 0 && request.resource.data.reponses <= 1000))
          && (nbInterets(request.resource.data) is int && nbInterets(request.resource.data) >= 0 && nbInterets(request.resource.data) <= 5))
        // auteur : « Ma demande est pourvue » (ou la rouvrir), sur une demande publiée
        || (request.auth != null && resource.data.uid == request.auth.uid && resource.data.statut == 'validee'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['pourvue'])
          && request.resource.data.pourvue is bool)
        // entreprise : +1 au compteur, dans la même écriture que son message (interets/{son uid}, contrôlé plus bas)
        || (request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nbInterets'])
          && request.resource.data.nbInterets == nbInterets(resource.data) + 1
          && !exists(/databases/$(database)/documents/demandes/$(id)/interets/$(request.auth.uid))
          && existsAfter(/databases/$(database)/documents/demandes/$(id)/interets/$(request.auth.uid)));
      allow delete: if estAdmin();

      match /prive/{doc} {
        allow get, list, delete: if estAdmin();
        allow create: if doc == 'contact'
          && contactValide(request.resource.data)
          && !exists(/databases/$(database)/documents/demandes/$(id))
          && getAfter(/databases/$(database)/documents/demandes/$(id)).data.statut == 'en_attente';
      }

      // Photos (1 à 3) : JPEG de 300 Ko au plus réduits dans le navigateur, en octets (pas de Cloud Storage, payant).
      // Écrites seulement avec la demande, dans la même écriture, par son auteur ; lisibles comme la demande ; supprimées par l'admin.
      match /photos/{pid} {
        allow get, list: if get(/databases/$(database)/documents/demandes/$(id)).data.statut == 'validee' || estAdmin()
          || (request.auth != null && get(/databases/$(database)/documents/demandes/$(id)).data.uid == request.auth.uid);
        allow create: if pid in ['1', '2', '3']
          && !exists(/databases/$(database)/documents/demandes/$(id))
          && getAfter(/databases/$(database)/documents/demandes/$(id)).data.uid == request.auth.uid
          && int(pid) <= getAfter(/databases/$(database)/documents/demandes/$(id)).data.get('photos', 0)
          && request.resource.data.keys().hasOnly(['data', 'cree'])
          && request.resource.data.data is bytes && request.resource.data.data.size() <= 300000
          && request.resource.data.cree == request.time;
        allow delete: if estAdmin();
      }

      // « Je suis intéressé » : message d'un artisan, lisible par l'admin seulement, qui le transmet au demandeur.
      // Un seul par entreprise (identifiant = son uid ; elle peut voir qu'elle a déjà répondu), sur une demande ouverte,
      // pas sur sa propre demande, avec le compteur de la demande augmenté de 1 dans la même écriture.
      match /interets/{iid} {
        allow get: if estAdmin() || connecte(iid);
        allow list, delete: if estAdmin();
        allow create: if iid == request.auth.uid && compteVerifie('entreprise') && interetValide(request.resource.data)
          && ouverte(get(/databases/$(database)/documents/demandes/$(id)).data)
          && get(/databases/$(database)/documents/demandes/$(id)).data.uid != request.auth.uid
          && nbInterets(getAfter(/databases/$(database)/documents/demandes/$(id)).data)
            == nbInterets(get(/databases/$(database)/documents/demandes/$(id)).data) + 1;
      }
    }

    // « Je cherche un partenaire » sur un appel d'offres public : lisible par l'admin seulement, qui met en relation les
    // entreprises d'un même avis. Une par entreprise et par avis (identifiant = <n° d'avis>_<uid> ; elle voit qu'elle a déjà écrit).
    // shortcut: la date limite de l'avis n'est pas vérifiée ici (les avis BOAMP ne sont pas dans Firestore) ; l'admin écarte les avis clos
    match /partenaires/{pid} {
      allow get: if estAdmin() || (request.auth != null && pid.matches('[0-9]{2}-[0-9]{1,7}_' + request.auth.uid));
      allow list, delete: if estAdmin();
      allow create: if request.auth != null && pid == request.resource.data.avis + '_' + request.auth.uid
        && compteVerifie('entreprise') && partenaireValide(request.resource.data);
    }

    // fiches/{uid} : fiche publique facultative d'une entreprise, dont le lien est envoyé au demandeur lors d'une mise en relation.
    // Nom, SIRET, métiers et zone = ceux du profil au moment de l'écriture, plus une présentation. Lisible par tous une fois
    // validée par l'admin (pas de liste publique) ; chaque écriture de l'entreprise la remet en attente.
    function ficheValide(d, p) {
      return d.keys().hasOnly(['nom', 'siret', 'metiers', 'zone', 'presentation', 'statut', 'maj'])
        && d.nom == p.nom && d.siret == p.siret && d.metiers == p.metiers && d.zone == p.zone
        && texte(d.presentation, 20, 600)
        && d.statut == 'en_attente' && d.maj == request.time;
    }

    match /fiches/{uid} {
      allow get: if connecte(uid) || estAdmin() || resource.data.statut == 'validee';
      allow list: if estAdmin();
      allow create: if connecte(uid) && compteVerifie('entreprise')
        && ficheValide(request.resource.data, get(/databases/$(database)/documents/users/$(uid)).data);
      allow update: if (connecte(uid) && compteVerifie('entreprise')
          && ficheValide(request.resource.data, get(/databases/$(database)/documents/users/$(uid)).data))
        || (estAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut'])
          && request.resource.data.statut in ['en_attente', 'validee']);
      allow delete: if connecte(uid) || estAdmin();
    }

    // Comptes : chacun lit et écrit seulement son profil ; le type ne change plus après la création ; l'admin lit tout ; aucune lecture publique.
    match /users/{uid} {
      allow get: if connecte(uid) || estAdmin();
      allow list: if estAdmin();
      // le type doit être celui de types/{uid} : supprimer puis recréer son profil ne change pas le type
      allow create: if connecte(uid) && profilValide(request.resource.data) && request.resource.data.cree == request.time
        && getAfter(/databases/$(database)/documents/types/$(uid)).data.type == request.resource.data.type;
      allow update: if connecte(uid) && profilValide(request.resource.data)
        && request.resource.data.type == resource.data.type && request.resource.data.cree == resource.data.cree;
      allow delete: if connecte(uid);
    }

    // types/{uid} : { type }, écrit une seule fois avec le premier profil, jamais modifié ni supprimé (sans nom ni coordonnée)
    match /types/{uid} {
      allow get: if connecte(uid) || estAdmin();
      allow create: if connecte(uid) && request.resource.data.keys().hasOnly(['type'])
        && request.resource.data.type in ['particulier', 'entreprise'];
    }
  }
}
